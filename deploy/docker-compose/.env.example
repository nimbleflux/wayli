############
# Wayli with Fluxbase - Environment Configuration
#
# Copy to .env and fill in the required secrets:
#   cp .env.example .env && ./generate-keys.sh
#
# generate-keys.sh fills ALL REQUIRED SECRETS below. Any variable listed as
# [REQUIRED] in docker-compose.yml uses ${VAR:?...} syntax, so `docker compose
# up` fails fast with a clear error if it is missing.
############

############
# REQUIRED SECRETS — filled automatically by ./generate-keys.sh
############

# PostgreSQL superuser password for the bundled fluxbase-postgres container.
# Used by both postgres and fluxbase (FLUXBASE_DATABASE_PASSWORD).
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT signing secret for Fluxbase authentication (min 32 chars, 48+ recommended).
# Generate with: openssl rand -base64 48
FLUXBASE_AUTH_JWT_SECRET=

# Anonymous API key — used by browser/Android clients for unauthenticated
# requests. Must be a JWT signed with FLUXBASE_AUTH_JWT_SECRET, role "anon".
# generate-keys.sh writes this for you.
FLUXBASE_ANON_KEY=

# Service role API key — used server-side (web app, admin operations).
# JWT signed with FLUXBASE_AUTH_JWT_SECRET, role "service_role".
# generate-keys.sh writes this for you.
FLUXBASE_SERVICE_ROLE_KEY=

# Key used by Fluxbase to encrypt integration credentials at rest.
# generate-keys.sh writes this for you.
FLUXBASE_ENCRYPTION_KEY=

# One-time token required to run the admin dashboard initial setup
# (only relevant when FLUXBASE_ADMIN_ENABLED=true).
# generate-keys.sh writes this for you.
FLUXBASE_SECURITY_SETUP_TOKEN=

############
# REQUIRED — public URL of the Wayli web app
############

# Where the Wayli web app is reachable; passed to Fluxbase as the only allowed
# CORS origin (FLUXBASE_CORS_ALLOWED_ORIGINS). Update for production.
SITE_URL=http://localhost:4000

############
# Optional — defaults shown are what docker-compose.yml uses when unset
############

# Wayli web image version
WAYLI_VERSION=v2.7.0-rc.1

# Host port the web UI is published on (container always listens on 80)
PORT=4000

# Public URL of the Fluxbase API, used by browser clients and the Android app.
# Update for production (e.g. https://flux.example.com).
FLUXBASE_PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL user and database name created on first boot
POSTGRES_USER=fluxbase
POSTGRES_DB=fluxbase

# Enable the Fluxbase admin dashboard UI and API routes
# (requires FLUXBASE_SECURITY_SETUP_TOKEN, above)
FLUXBASE_ADMIN_ENABLED=false

# Tavily web search API key (optional instance-level default; per-tenant keys
# can also be configured in the admin UI)
FLUXBASE_AI_TAVILY_API_KEY=

############
# Notes
############
# - Internal wiring (FLUXBASE_BASE_URL=http://fluxbase:8080, the db network,
#   storage buckets) is hardcoded in docker-compose.yml and needs no .env entry.
# - Any other FLUXBASE_* tuning variable must be added to the `environment:`
#   section of docker-compose.yml to take effect.
#
# Production checklist:
# ✓ All REQUIRED secrets generated (./generate-keys.sh)
# ✓ SITE_URL and FLUXBASE_PUBLIC_BASE_URL point at your real domains
# ✓ Admin disabled (FLUXBASE_ADMIN_ENABLED=false) unless needed
